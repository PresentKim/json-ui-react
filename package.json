{
  "name": "json-ui-react",
  "version": "1.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build:example": "tsx examples/research/build.ts",
    "typecheck": "tsc --noEmit",
    "build:addon": "tsx --tsconfig site/tsconfig.build.json example/pack-addon.ts",
    "site:build": "npm run build:addon && node site/prebuild.mjs && npm run site:sources && docusaurus build site",
    "site:start": "npm run build:addon && node site/prebuild.mjs && npm run site:sources && docusaurus start site",
    "site:sources": "node site/scripts/merge-sources.mjs && node site/scripts/gen-sources-page.mjs",
    "site:check": "node site/scripts/check.mjs",
    "site:test": "node --test site/scripts/*.test.mjs"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.52.3",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@types/node": "^22",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-gfm": "^4.0.1",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^2"
  }
}
