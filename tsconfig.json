{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "json-ui-react",
    "baseUrl": ".",
    "paths": {
      "json-ui-react": ["./src/index.ts"],
      "json-ui-react/*": ["./src/*"]
    },
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tests", "examples"]
}
