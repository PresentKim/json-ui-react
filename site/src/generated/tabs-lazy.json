{
  "id": "tabs-lazy",
  "file": "ui/jur.json",
  "keys": [
    "tl_lazy_1",
    "tl_tabs",
    "tl@jur.window"
  ],
  "text": "{\n  \"tl_lazy_1\": {\n    \"type\": \"stack_panel\",\n    \"size\": [\n      180,\n      128\n    ],\n    \"factory\": {\n      \"name\": \"jur_tl1\",\n      \"control_name\": \"jur.tl_pane_1\"\n    },\n    \"bindings\": [\n      {\n        \"binding_type\": \"view\",\n        \"binding_condition\": \"always\",\n        \"source_control_name\": \"jur_t1\",\n        \"source_property_name\": \"(#toggle_state * 1)\",\n        \"target_property_name\": \"#collection_length\"\n      }\n    ]\n  },\n  \"tl_tabs\": {\n    \"type\": \"stack_panel\",\n    \"orientation\": \"horizontal\",\n    \"size\": [\n      192,\n      22\n    ],\n    \"collection_name\": \"form_buttons\",\n    \"controls\": [\n      {\n        \"jur_t0@jur.tab_toggle\": {\n          \"collection_index\": 0,\n          \"$tab_index\": 0\n        }\n      },\n      {\n        \"jur_t1@jur.tab_toggle\": {\n          \"collection_index\": 1,\n          \"$tab_index\": 1\n        }\n      }\n    ]\n  },\n  \"tl@jur.window\": {\n    \"$mode_title\": \"Tabs: built by factory on select (D)\",\n    \"$tabs_def\": \"jur.tl_tabs\",\n    \"$panes_def\": \"jur.tl_panes\",\n    \"$tab\": 0\n  }\n}"
}
