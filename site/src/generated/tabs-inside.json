  "text": "{\n  \"ti_on_0\": {\n    \"type\": \"panel\",\n    \"size\": [\n      \"100%\",\n      \"100%\"\n    ],\n    \"controls\": [\n      {\n        \"face@jur.tab_face_on\": {}\n      },\n      {\n        \"pane@jur.ti_pane_0\": {\n          \"anchor_from\": \"top_left\",\n          \"anchor_to\": \"top_left\",\n          \"offset\": [\n            2,\n            48\n          ]\n        }\n      }\n    ]\n  },\n  \"ti_tabs\": {\n    \"type\": \"stack_panel\",\n    \"orientation\": \"horizontal\",\n    \"size\": [\n      192,\n      22\n    ],\n    \"collection_name\": \"form_buttons\",\n    \"controls\": [\n      {\n        \"jur_t0@jur.tab_toggle\": {\n          \"collection_index\": 0,\n          \"$tab_index\": 0,\n          \"$on_def\": \"jur.ti_on_0\"\n        }\n      },\n      {\n        \"jur_t1@jur.tab_toggle\": {\n          \"collection_index\": 1,\n          \"$tab_index\": 1,\n          \"$on_def\": \"jur.ti_on_1\"\n        }\n      }\n    ]\n  },\n  \"ti@jur.window\": {\n    \"$mode_title\": \"Tabs: pane inside the toggle (B)\",\n    \"$tabs_def\": \"jur.ti_tabs\",\n    \"$panes_def\": \"jur.panes_none\",\n    \"$tab\": 0\n  }\n}"
